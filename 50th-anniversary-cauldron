                        <path d="M179 56 C179 45, 172 38, 163 39 C167 47, 172 52, 179 56 Z" fill="url(#laurelGoldR)" opacity="0.85"/>

                        <!-- Top Crown Star -->
                        <polygon points="110,6 113,14 121,14 115,19 117,27 110,22 103,27 105,19 99,14 107,14" fill="#FEF08A"/>
                        <!-- Number 50 -->
                        <text x="110" y="76" text-anchor="middle" fill="url(#laurelGoldR)" font-family="Cinzel, serif" font-weight="800" font-size="48" letter-spacing="2">50</text>
                        <text x="110" y="96" text-anchor="middle" fill="#FDE68A" font-family="Cinzel, serif" font-weight="700" font-size="11" letter-spacing="4">ANNIVERSARY</text>
                    </svg>
                </div>

                <!-- Slogan Part 2 -->
                <h2 class="font-ceremony-tc gold-text font-black text-3xl sm:text-4xl md:text-5xl xl:text-[3.4rem] tracking-[0.14em] leading-tight">
                    以初心關顧同行
                </h2>
                <div class="w-36 sm:w-48 h-[2px] mt-3 sm:mt-4 bg-gradient-to-r from-transparent via-amber-300 to-transparent opacity-80"></div>
