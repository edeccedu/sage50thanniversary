    <!-- 3. Discreet Backstage Trigger Button (Bottom-Right Corner) -->
    <button id="backstage-trigger"
            title="Toggle Backstage Console (Shortcut: C)"
            aria-label="Toggle Backstage Console"
            class="fixed bottom-4 right-4 z-40 flex items-center gap-2 px-3 py-2 rounded-full bg-slate-900/80 border border-amber-500/30 text-amber-200 text-xs font-medium backdrop-blur-md shadow-lg cursor-pointer">
        <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/>
        </svg>
        <span class="hidden sm:inline">Stage Console [C]</span>
    </button>

    <!-- 4. Backstage Control Console Drawer (Hidden by default for clean projection) -->
    <div id="backstage-console"
         class="fixed bottom-16 right-4 z-50 w-[calc(100vw-2rem)] max-w-md rounded-2xl bg-slate-950/90 border border-amber-500/30 text-slate-100 p-5 shadow-2xl backdrop-blur-xl transition-all duration-300 transform translate-y-4 opacity-0 pointer-events-none">
        
        <!-- Header -->
        <div class="flex items-center justify-between pb-3 mb-4 border-b border-slate-800">
            <div class="flex items-center gap-2.5">
                <span id="status-dot" class="w-2.5 h-2.5 rounded-full bg-slate-500 transition-colors duration-300"></span>
                <div>
                    <h3 class="text-sm font-semibold text-amber-300 tracking-wide">BACKSTAGE FLAME CONTROL</h3>
                    <p id="stage-status-text" class="text-[11px] text-slate-400">Standby — Cauldron Unlit</p>
                </div>
            </div>
            <div class="flex items-center gap-1.5">
                <!-- Fullscreen Toggle -->
                <button id="btn-fullscreen"
                        title="Toggle Fullscreen Projection"
                        class="p-2 rounded-lg bg-slate-800/90 hover:bg-slate-700 text-slate-200 border border-slate-700 transition cursor-pointer">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"/>
                    </svg>
                </button>
                <!-- Hide Console Button -->
                <button id="btn-close-console"
                        title="Hide Console (Press C)"
                        class="p-2 rounded-lg bg-slate-800/90 hover:bg-slate-700 text-slate-300 border border-slate-700 transition cursor-pointer">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                </button>
            </div>
        </div>

        <!-- Intensity Slider -->
        <div class="mb-5">
            <div class="flex justify-between items-end mb-2">
                <label for="flame-slider" class="text-xs font-medium text-slate-300 uppercase tracking-wider">Flame Intensity</label>
                <div class="flex items-baseline gap-1">
                    <span id="intensity-value" class="text-2xl font-bold text-amber-400 tabular-nums">0</span>
                    <span class="text-xs text-amber-500 font-semibold">%</span>
                </div>
            </div>
            <input id="flame-slider" type="range" min="0" max="100" value="0" step="1" class="w-full stage-slider">
            <div class="flex justify-between text-[10px] text-slate-500 mt-1 px-0.5">
                <span>0% Unlit</span>
                <span>30% Ignite</span>
                <span>65% Rising</span>
                <span class="text-amber-400/80 font-semibold">95%+ Climax Reveal</span>
            </div>
        </div>

        <!-- Quick Stage Cue Presets -->
        <div class="grid grid-cols-4 gap-2 mb-4">
            <button data-preset="0"
                    class="preset-btn py-2.5 px-2 rounded-xl bg-slate-800/90 hover:bg-slate-700 border border-slate-700 text-xs font-semibold text-slate-300 transition active:scale-95 cursor-pointer">
                Off (0%)
            </button>
            <button data-preset="28"
                    class="preset-btn py-2.5 px-2 rounded-xl bg-amber-950/70 hover:bg-amber-900/70 border border-amber-700/50 text-xs font-semibold text-amber-200 transition active:scale-95 cursor-pointer">
                Ignite
            </button>
            <button data-preset="65"
                    class="preset-btn py-2.5 px-2 rounded-xl bg-orange-950/80 hover:bg-orange-900/70 border border-orange-600/50 text-xs font-semibold text-orange-200 transition active:scale-95 cursor-pointer">
                Medium
            </button>
            <button data-preset="100"
                    class="preset-btn py-2.5 px-2 rounded-xl bg-gradient-to-r from-amber-500 to-yellow-500 hover:from-amber-400 hover:to-yellow-400 text-slate-950 font-bold text-xs shadow-lg shadow-amber-500/30 transition active:scale-95 cursor-pointer">
                Peak Climax
            </button>
