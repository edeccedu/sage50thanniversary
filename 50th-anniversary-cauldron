        <!-- Audio Synthesis Option & Keyboard Shortcuts Guide -->
        <div class="flex items-center justify-between pt-3 border-t border-slate-800/80 text-[11px] text-slate-400">
            <label class="flex items-center gap-2 cursor-pointer hover:text-slate-200 transition">
                <input id="audio-toggle" type="checkbox" class="rounded accent-amber-500 w-3.5 h-3.5 cursor-pointer">
                <span>Ceremonial Flame Sound</span>
