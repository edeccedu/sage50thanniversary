                    <svg class="w-28 h-20 sm:w-36 sm:h-24 md:w-44 md:h-28 drop-shadow-[0_0_16px_rgba(251,191,36,0.65)]" viewBox="0 0 220 130" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <defs>
                            <linearGradient id="laurelGoldR" x1="0%" y1="0%" x2="100%" y2="100%">
                                <stop offset="0%" stop-color="#FEF9C3"/>
                                <stop offset="45%" stop-color="#FBBF24"/>
                                <stop offset="100%" stop-color="#B45309"/>
                            </linearGradient>
                        </defs>
                        <!-- Left Laurel Branch -->
                        <path d="M68 112 C35 96, 22 65, 34 30 C40 16, 52 10, 62 8" stroke="url(#laurelGoldR)" stroke-width="2.5" stroke-linecap="round"/>
                        <path d="M56 105 C42 102, 34 94, 38 86 C46 89, 53 96, 56 105 Z" fill="url(#laurelGoldR)"/>
                        <path d="M44 88 C28 83, 22 72, 28 63 C36 68, 42 78, 44 88 Z" fill="url(#laurelGoldR)"/>
