<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>五十載耆康安老 以初心關顧同行 — 聖火儀式</title>
    <!-- Tailwind CSS for crisp UI styling -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Noto Serif TC for ceremonial Traditional Chinese typography & Cinzel for gold emblems -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800&family=Inter:wght@400;500;600&family=Noto+Serif+TC:wght@600;700;900&display=swap" rel="stylesheet">

    <style>
        /* Base resets & custom ceremonial typography */
        * {
            box-sizing: border-box;
            user-select: none;
            -webkit-user-select: none;
        }

        body, html {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            background-color: #030712;
            font-family: 'Inter', sans-serif;
        }

        .font-ceremony-tc {
            font-family: 'Noto Serif TC', serif;
        }

        .font-ceremony-en {
            font-family: 'Cinzel', serif;
        }

        /* Metallic Gold Text Effect with Shimmer */
        .gold-text {
            background: linear-gradient(
                180deg,
                #FFFBEB 0%,
                #FDE68A 25%,
                #F59E0B 55%,
                #B45309 85%,
                #FDE68A 100%
            );
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            filter: drop-shadow(0 4px 18px rgba(245, 158, 11, 0.55)) drop-shadow(0 2px 4px rgba(0, 0, 0, 0.9));
        }

        /* Ceremonial Reveal Transitions */
        .climax-layer {
            opacity: 0;
            transform: scale(0.94) translateY(12px);
            transition: opacity 1.4s cubic-bezier(0.22, 1, 0.36, 1),
                        transform 1.6s cubic-bezier(0.22, 1, 0.36, 1);
            pointer-events: none;
        }

        .climax-layer.active {
            opacity: 1;
            transform: scale(1) translateY(0);
        }

        .slogan-left {
            opacity: 0;
            transform: translateX(-35px);
            transition: opacity 1.5s ease-out 0.2s, transform 1.6s cubic-bezier(0.16, 1, 0.3, 1) 0.2s;
        }

        .climax-layer.active .slogan-left {
            opacity: 1;
            transform: translateX(0);
        }

        .slogan-right {
            opacity: 0;
            transform: translateX(35px);
            transition: opacity 1.5s ease-out 0.45s, transform 1.6s cubic-bezier(0.16, 1, 0.3, 1) 0.45s;
        }

        .climax-layer.active .slogan-right {
            opacity: 1;
            transform: translateX(0);
        }

        /* Ambient Gold Ray Rotation */
        @keyframes slowSpin {
            from { transform: translate(-50%, -50%) rotate(0deg); }
            to { transform: translate(-50%, -50%) rotate(360deg); }
        }

        .sunburst-rays {
            animation: slowSpin 60s linear infinite;
        }

        /* Custom Range Slider for Backstage Console */
        input[type="range"].stage-slider {
            -webkit-appearance: none;
            appearance: none;
            background: transparent;
            cursor: pointer;
        }

        input[type="range"].stage-slider::-webkit-slider-runnable-track {
            height: 10px;
            border-radius: 999px;
            background: linear-gradient(90deg, #1e293b 0%, #92400e 45%, #f59e0b 85%, #fef08a 100%);
            border: 1px solid rgba(255, 255, 255, 0.15);
        }

        input[type="range"].stage-slider::-webkit-slider-thumb {
            -webkit-appearance: none;
            appearance: none;
            width: 24px;
            height: 24px;
            border-radius: 50%;
            background: radial-gradient(circle at 35% 35%, #ffffff, #fbbf24 60%, #d97706 100%);
            box-shadow: 0 0 15px rgba(251, 191, 36, 0.8), 0 2px 6px rgba(0, 0, 0, 0.7);
            margin-top: -8px;
            border: 2px solid #fffbeb;
            transition: transform 0.15s ease;
        }

        input[type="range"].stage-slider::-webkit-slider-thumb:hover {
            transform: scale(1.15);
        }

        /* Discreet Backstage Trigger Button (Almost invisible during projection) */
        #backstage-trigger {
            opacity: 0.12;
            transition: opacity 0.3s ease, transform 0.2s ease;
        }
        #backstage-trigger:hover, #backstage-trigger:focus {
            opacity: 0.9;
        }
    </style>
</head>
<body class="relative w-screen h-screen overflow-hidden bg-slate-950">

